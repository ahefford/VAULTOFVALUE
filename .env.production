# Crowd Control (Zonecall) — Firebase Web SDK config.
#
# This is committed on purpose: a Firebase *web* config (apiKey, appId,
# etc.) is not a secret — it's meant to be public, since it ships inside
# every visitor's JS bundle regardless. Real access control lives in
# crowd/firestore.rules (per-user, via Firebase Auth), not in hiding this
# file. Vite loads .env.production automatically for `npm run build`
# (production mode), so GitHub Pages' build picks this up with no workflow
# changes needed.
#
# To point at a different Firebase project (e.g. local development against
# your own), copy the relevant keys into a gitignored .env.local instead —
# see .env.example. .env.local always wins over this file.

VITE_ZC_API_KEY=AIzaSyCp9HncfB95m2OCo6a5lY7Ac7bOpyqx1qU
VITE_ZC_AUTH_DOMAIN=zonecall-83044.firebaseapp.com
VITE_ZC_PROJECT_ID=zonecall-83044
VITE_ZC_STORAGE_BUCKET=zonecall-83044.firebasestorage.app
VITE_ZC_MESSAGING_SENDER_ID=109561145972
VITE_ZC_APP_ID=1:109561145972:web:3acebde20f3d315b4e3f21
VITE_ZC_EVENT_ID=vault26
