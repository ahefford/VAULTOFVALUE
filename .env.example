# Crowd Control (Zonecall) — Firebase Web SDK config.
# Copy this file to .env.local (gitignored) and fill in real values from:
# Firebase console → zonecall-83044 → Project settings → General → Your apps → Web app.
#
# Also enable Authentication → Sign-in method → Anonymous, and create a
# Firestore database (production mode), then apply crowd/firestore.rules.

VITE_ZC_API_KEY=
VITE_ZC_AUTH_DOMAIN=zonecall-83044.firebaseapp.com
VITE_ZC_PROJECT_ID=zonecall-83044
VITE_ZC_STORAGE_BUCKET=zonecall-83044.appspot.com
VITE_ZC_MESSAGING_SENDER_ID=109561145972
VITE_ZC_APP_ID=

# Slug the whole team's data lives under in Firestore (/events/{eventId}/...).
# Change per-event; keep it out of search engines — it is the only thing
# gating access to this event's roster (see crowd/firestore.rules).
VITE_ZC_EVENT_ID=vault26
