rules_version = '2';

// Crowd Control (Zonecall) — Firestore security rules.
//
// This app has no server of its own (it's a static site), so the only
// gate available is Firebase Authentication. We use Anonymous Auth: every
// device gets a real (if pseudonymous) Firebase UID the moment it loads
// the app, and every read/write below requires that UID to be present.
//
// This is NOT per-person access control — any signed-in device can read
// or write any document under an event, including messing with other
// people's status or roster entries. That's an accepted tradeoff for a
// small trusted team working one event, gated further by the event slug
// (VITE_ZC_EVENT_ID) not being public. Do not reuse this project for
// anything where that isn't an acceptable risk without adding a backend
// (e.g. Cloud Functions) to enforce per-user permissions properly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
